{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "typecheck": "tsc --noEmit",
    "perf:lighthouse": "lhci autorun || echo \"Install @lhci/cli to enable CI Lighthouse\"",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:status": "prisma migrate status",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:seed": "tsx src/features/database/seed.ts"
  },
  "dependencies": {
    "@paypal/paypal-server-sdk": "^2.4.0",
    "@prisma/client": "^5.18.0",
    "@stripe/stripe-js": "^4.9.0",
    "bcryptjs": "^3.0.3",
    "next": "14.2.5",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "stripe": "^16.12.0",
    "zod": "^3.23.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@sentry/nextjs": "^10.62.0",
    "@testing-library/jest-dom": "^6.0.4",
    "@testing-library/react": "^14.0.0",
    "@testing-library/user-event": "^14.6.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/jest": "^29.5.5",
    "@types/node": "^20.14.2",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "eslint": "^8.57.0",
    "eslint-config-next": "14.2.5",
    "eslint-plugin-vitest": "^0.5.4",
    "jsdom": "^23.2.0",
    "postcss": "^8.4.37",
    "prisma": "^5.18.0",
    "tailwindcss": "^3.4.4",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vite": "^5.4.1",
    "vitest": "^4.1.9"
  }
}
