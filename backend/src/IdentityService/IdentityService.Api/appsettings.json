{
  "ConnectionStrings": {
    "AuthDatabase": "Data Source=identity-auth.db",
    "P2PRecipientDirectory": "Data Source=p2p-recipient-directory.db",
    "PaymentRequestsDatabase": "Data Source=payment-requests.db"
  },
  "Auth": {
    "Jwt": {
      "Issuer": "https://identity.afrikawallet.local",
      "Audience": "afrikawallet-mobile"
    }
  },
  "PaymentRequests": {
    "Outbox": {
      "Enabled": false,
      "IntervalSeconds": 30,
      "BatchSize": 50,
      "MaxDeliveryAttempts": 3
    },
    "Webhook": {
      "Enabled": false
    }
  }
}
