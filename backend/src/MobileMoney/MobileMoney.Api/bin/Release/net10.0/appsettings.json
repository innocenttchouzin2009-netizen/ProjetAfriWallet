{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "MtnMomo": {
    "Environment": "Development",
    "EnableProduction": false,
    "BaseUrl": "https://sandbox.example.com",
    "ApiUserSecretName": "MTN_MOMO_API_USER",
    "ApiKeySecretName": "MTN_MOMO_API_KEY",
    "SubscriptionKeySecretName": "MTN_MOMO_SUBSCRIPTION_KEY",
    "CallbackSecretName": "MTN_MOMO_CALLBACK_SECRET",
    "TimeoutSeconds": 30
  }
}
