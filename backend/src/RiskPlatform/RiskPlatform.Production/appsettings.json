{
  "RiskProduction": {
    "EnableProductionMode": false,
    "RequireHttpsOutsideDevelopment": true,
    "RequiredEnvironmentVariables": [
      "AFW_RISK_DB_CONNECTION",
      "AFW_RISK_OTEL_ENDPOINT",
      "AFW_RISK_INTERNAL_API_KEY"
    ]
  },
  "Resilience": {
    "TimeoutSeconds": 15,
    "Retry": {
      "MaxRetries": 3,
      "BackoffMilliseconds": 200
    },
    "CircuitBreaker": {
      "FailureThreshold": 0.5,
      "MinimumThroughput": 20,
      "BreakDurationSeconds": 30,
      "HalfOpenMaxCalls": 5
    }
  },
  "FeatureFlags": {
    "EnableMetricsEndpoint": true,
    "EnableEnhancedAudit": true,
    "EnableStrictSecretScan": true
  },
  "OpenTelemetry": {
    "Enabled": true,
    "ServiceName": "afriwallet-risk-platform",
    "Endpoint": "http://localhost:4317"
  },
  "RateLimiting": {
    "PermitLimit": 100,
    "WindowSeconds": 60,
    "QueueLimit": 0
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
