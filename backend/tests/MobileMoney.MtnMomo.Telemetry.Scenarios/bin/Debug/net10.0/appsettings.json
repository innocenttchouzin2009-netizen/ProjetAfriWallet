{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "MtnMomo": {
    "Environment": "Development",
    "EnableProduction": false,
    "BaseUrl": "https://sandbox.example.com",
    "ApiUserSecretName": "MTN_MOMO_API_USER",
    "ApiKeySecretName": "MTN_MOMO_API_KEY",
    "SubscriptionKeySecretName": "MTN_MOMO_SUBSCRIPTION_KEY",
    "CallbackSecretName": "MTN_MOMO_CALLBACK_SECRET",
    "TimeoutSeconds": 30
  },
  "Resilience": {
    "Retry": {
      "MaximumAttempts": 3,
      "BaseDelayMs": 250,
      "UseExponentialBackoff": true,
      "UseJitter": true
    },
    "Timeout": {
      "RequestTimeoutSeconds": 10
    },
    "CircuitBreaker": {
      "FailureRatio": 0.5,
      "SamplingDurationSeconds": 30,
      "MinimumThroughput": 20,
      "BreakDurationSeconds": 60
    }
  },
  "FeatureFlags": {
    "MtnMomo.Enabled": true,
    "MtnMomo.Sandbox.Enabled": true,
    "MtnMomo.Production.Enabled": false,
    "MtnMomo.Deposit.Enabled": true,
    "MtnMomo.Withdrawal.Enabled": true,
    "MtnMomo.Status.Enabled": true,
    "MtnMomo.Callbacks.Enabled": true,
    "MtnMomo.Flutter.Enabled": true,
    "MtnMomo.AutoPolling.Enabled": false,
    "MtnMomo.Receipts.Enabled": true
  },
  "OpenTelemetry": {
    "ServiceName": "afriwallet-mobile-money",
    "ServiceVersion": "0.7.3.4",
    "Environment": "Staging",
    "EnableConsoleExporter": false,
    "EnableOtlpExporter": true,
    "OtlpEndpoint": "http://otel-collector:4317",
    "EnablePrometheusExporter": true
  },
  "MobileMoneyRateLimiting": {
    "StatusPerIp": {
      "PermitLimit": 60,
      "WindowSeconds": 60
    },
    "OperationsPerAwid": {
      "PermitLimit": 10,
      "WindowSeconds": 60
    },
    "OperationsPerWallet": {
      "PermitLimit": 5,
      "WindowSeconds": 60
    },
    "OperationsPerPhone": {
      "PermitLimit": 5,
      "WindowSeconds": 600
    },
    "ConnectorConcurrency": {
      "PermitLimit": 100,
      "QueueLimit": 50
    },
    "Callback": {
      "PermitLimit": 120,
      "WindowSeconds": 60
    }
  }
}
